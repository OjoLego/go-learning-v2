# Application Environment
# Options: development, test, production
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=dime_user
DB_PASSWORD=dime_password
DB_NAME=dime
DB_SSL_MODE=disable

# Server Configuration
SERVER_PORT=8080
# Timeouts are set automatically based on APP_ENV:
# - development: 30s read, 60s write
# - production: 5s read, 10s write
# - test: 2s read, 5s write
# Uncomment to override:
# SERVER_READ_TIMEOUT=30
# SERVER_WRITE_TIMEOUT=60

# Logging
# Options: debug, info, warn, error
LOG_LEVEL=debug