# =============================================================================
# Dime API - Environment Configuration
# Copy this file to .env and adjust values for your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
# Options: development, test, production
# development: verbose logging, permissive timeouts, default DB password
# test: minimal logging, fast timeouts
# production: strict timeouts, warn logging, requires DB password and SSL
APP_ENV=development

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Controls structured log verbosity.
# Options: debug, info, warn, error
# development default: debug
# production default: warn
# test default: error
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=dime_user
DB_PASSWORD=dime_password
DB_NAME=dime
# SSL mode: disable, require, verify-full
# Use require or verify-full in production.
DB_SSL_MODE=disable

# Connection pool settings
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=5m
DB_CONN_IDLE_TIME=1m

# -----------------------------------------------------------------------------
# HTTP Server Configuration
# -----------------------------------------------------------------------------
SERVER_PORT=8080

# Request timeouts in seconds.
# If unset, defaults are chosen by APP_ENV:
#   development: 30s read, 60s write
#   production:  5s read, 10s write
#   test:        2s read, 5s write
# Uncomment to override:
# SERVER_READ_TIMEOUT=30
# SERVER_WRITE_TIMEOUT=60

# -----------------------------------------------------------------------------
# Authentication (JWT)
# -----------------------------------------------------------------------------
# Secret used to sign JWT tokens. MUST be changed in production.
# Use a cryptographically random string of at least 32 characters.
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Token lifetime in minutes.
JWT_EXPIRY_MINUTES=60

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Requests per second allowed per user/IP.
RATE_LIMIT_RPS=10

# Maximum burst capacity per user/IP.
# A client can make up to this many requests in a short burst.
RATE_LIMIT_BURST=20

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API.
# Use "*" to allow all origins (not recommended for production).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
